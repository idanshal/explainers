---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Icon } from '@astrojs/starlight/components';
import ArticleMetadata from '../components/ArticleMetadata.astro';
import catalog from '../data/catalog.json';

const totalExplainers = catalog.reduce((total, category) => total + category.entries.length, 0);
const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (route) => `${basePath}${route.replace(/^\/+/, '')}`;
const topicId = (name) => `topic-${name.toLowerCase().replaceAll(' ', '-')}`;
const entries = catalog.flatMap((category) => category.entries);
const guide = (contentPath) => {
        const entry = entries.find((item) => item.contentPath === contentPath);
        if (!entry) throw new Error(`Homepage guide not found in catalog: ${contentPath}`);
        return entry;
};
const topicDescriptions = {
        'AI': 'Models, coding agents, tools, and context.',
        'Databases': 'Data models, PostgreSQL, Neo4j, and migrations.',
        'Java': 'Language concepts, libraries, and persistence.',
        'Spring Boot': 'Application design, data access, and testing.',
        'Build Tools': 'Maven builds, wrappers, and plugins.',
        'Command-Line Tools': 'Practical tools for everyday work.',
        'Web Development': 'Inspect and debug the web.',
        'Deployment': 'Publishing applications and managing releases.',
        'Containers': 'Docker images, networking, storage, and operations.',
        'Networking': 'Secure connections, keys, and GitHub.',
        'Security': 'Authorization and OAuth flows.',
        'CI/CD': 'Automate builds and delivery with GitHub Actions.',
        'Workflow Orchestration': 'Reliable workflows and background processing with Temporal.',
};
const paths = [
        {
                title: 'Build with AI agents',
                description: 'From the basic concepts to the tools agents use.',
                guides: ['ai/concepts.md', 'ai/coding-agents.md', 'ai/mcp.md'].map(guide),
        },
        {
                title: 'Work with PostgreSQL',
                description: 'Learn the fundamentals, practice SQL, and connect an application.',
                guides: ['databases/postgresql/fundamentals.md', 'databases/postgresql/sql-lab.md', 'databases/postgresql/java-spring-boot.md'].map(guide),
        },
        {
                title: 'Get started with Docker',
                description: 'Understand containers and run a multi-service application.',
                guides: ['containers/docker/index.md', 'containers/docker/build-tag-and-run.md', 'containers/docker/compose.md'].map(guide),
        },
];
const problems = [
        'spring-boot/testing/database-connection-exhaustion.md',
        'containers/docker/troubleshooting.md',
        'databases/concepts/foreign-keys-and-indexes.md',
].map(guide);
---

<StarlightPage frontmatter={{ title: 'Explainers', description: 'Clear mental models for software, tools, and systems.', template: 'splash' }}>
        <main class="library-home">
                <section class="opening" aria-labelledby="page-title">
                        <div class="opening-copy">
                                <p class="eyebrow"><span class="eyebrow-mark" aria-hidden="true"></span> An independent field guide</p>
                                <h1 id="page-title">What do you want to understand?</h1>
                                <p class="opening-note">Practical explainers for software concepts, tools, and the problems you meet along the way.</p>
                                <div class="opening-actions">
                                        <button class="home-search" type="button"><Icon name="magnifier" size="1.1rem" /> Search explainers</button>
                                        <a class="browse-link" href="#library">Browse all guides <span aria-hidden="true">&darr;</span></a>
                                </div>
                        </div>
                </section>

                <section class="discovery-section" id="topics" aria-labelledby="topics-title">
                        <div class="section-heading">
                                <div><p class="eyebrow">Find your starting point</p><h2 id="topics-title">Explore by topic.</h2></div>
                                <p class="collection-count"><strong>{totalExplainers}</strong> explainers<br />across <strong>{catalog.length}</strong> topics</p>
                        </div>
                        <div class="topic-grid">
                                {catalog.map((category, index) => (
                                        <a class="topic-tile" href={`#${topicId(category.name)}`}>
                                                <span class="topic-number">{String(index + 1).padStart(2, '0')}</span>
                                                <span class="topic-tile-content"><strong>{category.name}</strong><span>{topicDescriptions[category.name] ?? `${category.entries.length} guides to explore.`}</span></span>
                                                <span class="topic-arrow" aria-hidden="true">&rarr;</span>
                                        </a>
                                ))}
                        </div>
                </section>

                <section class="discovery-section" aria-labelledby="paths-title">
                        <div class="section-heading"><div><p class="eyebrow">A little direction</p><h2 id="paths-title">Follow a path.</h2></div></div>
                        <div class="path-grid">
                                {paths.map((path, index) => (
                                        <article class="path-item">
                                                <span class="topic-number">0{index + 1} / LEARNING PATH</span>
                                                <h3>{path.title}</h3>
                                                <p>{path.description}</p>
                                                <ol>{path.guides.map((entry) => <li><a href={withBase(entry.route)}>{entry.title}</a></li>)}</ol>
                                        </article>
                                ))}
                        </div>
                </section>

                <section class="discovery-section" aria-labelledby="problems-title">
                        <div class="section-heading"><div><p class="eyebrow">Practical answers</p><h2 id="problems-title">Solve a problem.</h2></div></div>
                        <div class="problem-list">
                                {problems.map((entry) => (
                                        <a class="problem-link" href={withBase(entry.route)}><span><strong>{entry.title}</strong><span>{entry.description}</span></span><span aria-hidden="true">&rarr;</span></a>
                                ))}
                        </div>
                </section>

                <section class="library" id="library" aria-labelledby="library-title">
                        <div class="section-heading"><div><p class="eyebrow">The complete collection</p><h2 id="library-title">Browse all guides.</h2></div></div>
                        <div class="topic-list">
                                {catalog.map((category, index) => {
                                        const visibleEntries = category.entries.filter((entry) => !category.sections.some((section) => section.entries.some((item) => item.contentPath === entry.contentPath)));
                                        return (
                                                <section class="topic-row" id={topicId(category.name)}>
                                                        <div class="topic-meta">
                                                                <span class="topic-number">{String(index + 1).padStart(2, '0')}</span>
                                                                <h3>{category.route ? <a href={withBase(category.route)}>{category.name}</a> : category.name}</h3>
                                                                <span class="topic-count">{category.entries.length} guides</span>
                                                        </div>
                                                        <div class="topic-groups">
                                                                {visibleEntries.length > 0 && <ul class="topic-links">{visibleEntries.map((entry) => <li><a href={withBase(entry.route)}><strong>{entry.title}</strong><span>{entry.description}</span></a><ArticleMetadata level={entry.level} readingMinutes={entry.readingMinutes} compact /></li>)}</ul>}
                                                                {category.sections.map((section) => (
                                                                        <section class="topic-group"><h4>{section.name}</h4><ul class="topic-links">{section.entries.map((entry) => <li><a href={withBase(entry.route)}><strong>{entry.title}</strong><span>{entry.description}</span></a><ArticleMetadata level={entry.level} readingMinutes={entry.readingMinutes} compact /></li>)}</ul></section>
                                                                ))}
                                                        </div>
                                                </section>
                                        );
                                })}
                        </div>
                </section>
                <footer class="library-footer"><span>Written to be understood. Kept in the open.</span><a href="https://github.com/idanshal/explainers">Read the source on GitHub <span aria-hidden="true">↗</span></a></footer>
        </main>
</StarlightPage>

<script>
        document.querySelector('.home-search')?.addEventListener('click', (event) => {
                event.stopPropagation();
                document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click();
        });
</script>
