---
import { Braces, Clock, KeyRound, PackageOpen, ToggleRight } from '@lucide/astro';
import {
        siApachemaven,
        siCloudflare,
        siDocker,
        siFlyway,
        siGoogle,
        siGithub,
        siGithubactions,
        siGithubcopilot,
        siGithubpages,
        siGooglechrome,
        siHibernate,
        siHomebrew,
        siModelcontextprotocol,
        siNeo4j,
        siNginx,
        siOpenjdk,
        siPandoc,
        siPostgresql,
        siSpring,
        siTemporal,
        siVim,
} from 'simple-icons';

const { level, readingMinutes, technologies = [], compact = false } = Astro.props;
const labels = { foundations: 'Foundations', intermediate: 'Intermediate', advanced: 'Advanced' };
const steps = { foundations: 1, intermediate: 2, advanced: 3 };
const javaIconUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/icons/java.svg`;
const genericTechnologyIcons = {
        'Agent Package Manager': PackageOpen,
        'LaunchDarkly': ToggleRight,
        'Microsoft Entra ID': KeyRound,
        jq: Braces,
};
const technologyIcons = {
        'Apache Maven': siApachemaven,
        'Cloudflare Pages': siCloudflare,
        Docker: siDocker,
        Flyway: siFlyway,
        Google: siGoogle,
        GitHub: siGithub,
        'GitHub Actions': siGithubactions,
        'GitHub Copilot': siGithubcopilot,
        'GitHub Pages': siGithubpages,
        'Chrome DevTools': siGooglechrome,
        Hibernate: siHibernate,
        Homebrew: siHomebrew,
        'Model Context Protocol': siModelcontextprotocol,
        Neo4j: siNeo4j,
        NGINX: siNginx,
        OpenJDK: siOpenjdk,
        Pandoc: siPandoc,
        PostgreSQL: siPostgresql,
        Spring: siSpring,
        'Spring Boot': siSpring,
        Temporal: siTemporal,
        Vim: siVim,
};
---

<div class:list={['article-meta', { compact }]}>
        {level && <span class="level">
                <span class="level-mark" aria-hidden="true">
                        {[1, 2, 3].map((step) => <span class:list={['level-step', { active: step <= steps[level] }]}></span>)}
                </span>
                <span>{labels[level]}</span>
        </span>}
        <span class="reading-time"><Clock size={14} strokeWidth={1.7} aria-hidden="true" /> ~{readingMinutes} min read</span>
</div>
{!compact && technologies.length > 0 && <ul class="technology-list" aria-label="Technologies">
        {technologies.map((technology) => {
                const icon = technologyIcons[technology];
                const GenericIcon = genericTechnologyIcons[technology];
                return <li>
                        {technology === 'Java'
                                ? <img src={javaIconUrl} alt="" aria-hidden="true" />
                                : icon
                                        ? <svg viewBox="0 0 24 24" style={`--technology-icon-color: #${icon.hex}`} aria-hidden="true"><path fill="currentColor" d={icon.path} /></svg>
                                        : GenericIcon && <GenericIcon size={18} strokeWidth={1.7} aria-hidden="true" />}
                        <span>{technology}</span>
                </li>;
        })}
</ul>}

<style>
        .article-meta {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 0.6rem 1.2rem;
                margin-top: 0.8rem;
                color: var(--muted);
                font-family: var(--sl-font);
                font-size: 0.85rem;
                line-height: 1.4;
        }
        .article-meta.compact {
                gap: 0.4rem 0.9rem;
                margin-top: 0.35rem;
                font-size: 0.75rem;
        }
        .level, .reading-time, .level-mark {
                display: inline-flex;
                align-items: center;
        }
        .level, .reading-time { gap: 0.4rem; }
        .level { color: var(--link-accent); font-weight: 600; }
        .level-mark { gap: 2px; }
        .level-step {
                width: 4px;
                height: 11px;
                border-radius: 1px;
                background: var(--sl-color-hairline);
        }
        .level-step.active { background: var(--signal); }
        .level-step:nth-child(1) { height: 5px; }
        .level-step:nth-child(2) { height: 8px; }
        .technology-list {
                display: flex;
                flex-wrap: wrap;
                gap: 0.45rem 1rem;
                margin: 0.55rem 0 0;
                padding: 0;
                color: var(--sl-color-text);
                font-family: var(--sl-font);
                font-size: 0.84rem;
                line-height: 1.4;
                list-style: none;
        }
        .technology-list li {
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
        }
        .technology-list svg,
        .technology-list img {
                width: 1.1rem;
                height: 1.1rem;
                flex: none;
        }
        .technology-list svg {
                color: var(--technology-icon-color);
        }
        :global(:root[data-theme='dark']) .technology-list svg {
                color: color-mix(in srgb, var(--technology-icon-color), white 58%);
        }
</style>